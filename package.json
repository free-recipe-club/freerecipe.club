{
  "name": "freerecipe-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:server & npm run dev:css",
    "dev:server": "tsx watch server.ts",
    "dev:css": "npx @tailwindcss/cli -i ./app/styles/input.css -o ./public/styles/output.css --watch",
    "start": "tsx server.ts",
    "build:css": "npx @tailwindcss/cli -i ./app/styles/input.css -o ./public/styles/output.css --minify",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-recipes.ts"
  },
  "dependencies": {
    "remix": "next",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
