---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Welcome to the Free Recipe Club.">
	<nav class="bg-white shadow-sm border-b">
		<div class="container mx-auto px-4 py-4">
			<div class="flex justify-between items-center">
				<div class="flex items-center space-x-2">
					<img src="frying_pan.svg" alt="frying pan" class="h-8 w-8" />
					<a href="/" class="text-xl font-bold text-gray-800">Free Recipe Club</a>
				</div>
				<div class="space-x-4">
					<a href="/" class="text-gray-600 hover:text-gray-800">Home</a>
					<a href="/recipes" class="text-gray-600 hover:text-gray-800">Recipes</a>
				</div>
			</div>
		</div>
	</nav>
	
	<main class="container mx-auto px-4 py-8">
		<div class="text-center max-w-3xl mx-auto">
			<h1 class="text-5xl font-bold mb-6">
				Something <span class="text-gradient">exciting</span> is cooking.
			</h1>
			
			<p class="text-xl text-gray-600 mb-8">
				Welcome to Free Recipe Club - a community where we share our favorite recipes and culinary stories.
			</p>
			
			<div class="mb-8">
				<img 
					src="frying_pan.svg" 
					alt="frying pan" 
					class="motion-safe:hover:animate-[wiggle_1s_ease-in-out_infinite] h-96 mx-auto" 
				/>
			</div>
			
			<div class="space-y-4">
				<a 
					href="/recipes" 
					class="inline-block bg-gradient-to-r from-purple-600 to-pink-600 text-white px-8 py-3 rounded-lg font-semibold hover:shadow-lg transition-shadow"
				>
					Browse Our Recipes
				</a>
				
				<p class="text-gray-600">
					Discover delicious recipes shared by our community members from around the world.
				</p>
			</div>
		</div>
	</main>
</Layout>

<style>
	:root {
		--astro-gradient: linear-gradient(0deg, #4f39fa, #da62c4);
	}

	.text-gradient {
		font-weight: 900;
		background-image: var(--astro-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-size: 100% 200%;
		background-position-y: 100%;
		border-radius: 0.4rem;
		animation: pulse 4s ease-in-out infinite;
	}

	@keyframes pulse {
		0%,
		100% {
			background-position-y: 0%;
		}
		50% {
			background-position-y: 80%;
		}
	}

	@keyframes wiggle {
		0%, 100% { transform: rotate(-3deg); }
		50% { transform: rotate(3deg); }
	}
</style>
